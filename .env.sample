# Copy to .env and fill in the blank values. Never commit .env.
# Shared by every service in docker-compose.yml.

# --- Shared ---
TZ=UTC

# --- Database (db) ---
POSTGRES_DB=estancias
POSTGRES_USER=estancias_user
POSTGRES_PASSWORD=
# Host port, bound to 127.0.0.1 only
POSTGRES_PORT=5432

# --- API (api) ---
# Bootstrap admin: role 4 = Director, subsidiary 0 = Null (both seeded by db migrations)
# Host port, bound to 127.0.0.1 only
API_PORT=8000
JWT_SECRET=
JWT_TTL_MINUTES=60
DB_POOL_MAX_SIZE=10
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE_ID=4
BOOTSTRAP_SUBSIDIARY_ID=0
